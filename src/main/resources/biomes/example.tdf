# rules: everything must be on the start of the line, intendation is bloat. everything must have a type as the first ...
# character, 256 types is more than enough and more than this would also cause bloat. the format must always be:
#                                           defines { a_class type name value


#comment

{ class
i id 1234

{ object

{ attributes
itemwithoutvalue
i number 1
h hex FF
b bin 1010
B booltrue T
B boolfalse F
f float 3.14
" text example
' character x
S textblock
line 1
line2
\
< customitem insert bracket data
` customitem2 insert backtick data
@ pointer class.id
}
#attributes

}
#object

}
#class
